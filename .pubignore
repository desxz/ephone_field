# Local / IDE
.dart_tool/
.packages
.pub/
build/
**/doc/api/
.idea/
.vscode/
*.iml
.DS_Store
.fvm/

# Native build outputs (never publish)
ios/build/
android/.cxx/
android/build/
example/**/build/

# Maintainer source tree — consumers use shipped prebuilt natives
third_party/
src/
tool/
doc/

# Accidental object noise (prebuilts are allowlisted below)
*.o
*.dylib
*.xcframework/

# Do not publish random archives / shared libs outside known prebuilt paths
*.a
!ios/prebuilt/libephone_phonenumber_stack-iphoneos.a
!ios/prebuilt/libephone_phonenumber_stack-iphonesimulator.a
*.so
!android/src/main/jniLibs/**/libephone_field.so
